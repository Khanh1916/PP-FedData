# Machine-specific config
configs/local.yaml

# Data (large, not committed): everything under data/, including the sensitivity worlds (_sens) and the MIA runs (_mia)
data/*
!data/.gitkeep

# Round R: the outputs of the first study (Normal extracted without the authors' filter), kept as a backup
/data_v1/
/artifacts_v1/

# Artifacts
artifacts/*/
artifacts/*.db
artifacts/*.json
artifacts/*.yaml
artifacts/*.csv
artifacts/*.log

# Results (generated). Aggregate reports (md) and figures (png) are tracked; CSV/JSON intermediates are not.
results/*.csv
results/figures/*
!results/figures/*.png
results/reports/*
!results/reports/*.md
!results/reports/recommend.html

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Pytest
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# The team's own working files, kept out of the public repository: an explainer of FedDP-Marginal, the supervisor report,
